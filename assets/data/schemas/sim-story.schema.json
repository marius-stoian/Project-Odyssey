{
  "title": "assets/data/sim/story.json",
  "type": "object",
  "properties": {
    "season": {
      "type": "object",
      "description": "A failed harvest now and then gives the clan a hard winter to live through.",
      "properties": {
        "leanAutumnPercent": {
          "type": "integer",
          "description": "Chance each autumn that the harvest fails",
          "minimum": 0,
          "maximum": 100,
          "default": 20,
          "example": "20"
        },
        "leanForagePercent": {
          "type": "integer",
          "description": "The land then gives this share of its usual autumn food",
          "minimum": 0,
          "maximum": 100,
          "default": 45,
          "example": "45"
        }
      }
    },
    "causes": {
      "type": "object",
      "description": "How far back an event looks for its causes, and how much of it a person remembers.",
      "properties": {
        "theftWindowDays": {
          "type": "integer",
          "description": "Thefts this recent are blamed for an empty store",
          "minimum": 1,
          "maximum": 3650,
          "default": 20,
          "example": "20"
        },
        "starvationWindowDays": {
          "type": "integer",
          "description": "An empty store this recent is blamed for a death by hunger",
          "minimum": 1,
          "maximum": 3650,
          "default": 60,
          "example": "60"
        },
        "maxCauses": {
          "type": "integer",
          "description": "An event lists at most this many causes",
          "minimum": 1,
          "maximum": 20,
          "default": 4,
          "example": "4"
        },
        "grudgeLimit": {
          "type": "integer",
          "description": "A person holds at most this many grudges",
          "minimum": 1,
          "maximum": 200,
          "default": 16,
          "example": "16"
        }
      }
    },
    "quarrel": {
      "type": "object",
      "description": "Every morning each person meets someone; people who dislike each other may quarrel.",
