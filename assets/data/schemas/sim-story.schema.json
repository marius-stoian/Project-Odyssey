          "minimum": 0,
          "maximum": 100,
          "default": 40,
          "example": "40"
        },
        "dislikeOpinion": {
          "type": "integer",
          "description": "Both must think this badly of each other or worse",
          "minimum": -100,
          "maximum": 100,
          "default": -10,
          "example": "-10"
        },
        "irritableBelow": {
          "type": "integer",
          "description": "Hunger or Energy below this makes a person short-tempered",
          "minimum": 0,
          "maximum": 100,
          "default": 60,
          "example": "60"
        },
        "irritablePercent": {
          "type": "integer",
          "description": "Chance of a quarrel when short-tempered",
          "minimum": 0,
          "maximum": 100,
          "default": 40,
          "example": "40"
