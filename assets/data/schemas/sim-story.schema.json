          "maximum": 100,
          "default": 30,
          "example": "30"
        },
        "feeling": {
          "type": "integer",
          "description": "The victim's memory of the attack",
          "minimum": -100,
          "maximum": 0,
          "default": -80,
          "example": "-80"
        }
