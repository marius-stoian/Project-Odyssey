// Gather from a plant that is ripe. Today it does what the game always did: the hero gathers at once and the plant regrows
// elsewhere (the built-in action "gather"). US-153 turns this into a timed action with the effects written out here.
{
  "id": "gather",
  "label": "Gather",
  "note": "Reach 2 m, instant: the same as before the interactions moved into data.",
  "actors": ["hero", "person"],
  "target": { "tags": ["edible", "plant"] },
  "range": 2,
  "order": 10,
  "requires": [
    { "if": "target.state == ripe", "else": "Nothing to pick yet" }
  ],
  "effects": [ "do gather" ],
  "npc": { "score": "need(hunger) * 2 + trait(diligent) * 10", "cooldown": 60 }
}
