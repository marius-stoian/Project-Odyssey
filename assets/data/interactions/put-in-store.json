// A food store holds berries for later: two berries in, state stocked.
{
  "id": "put-in-store",
  "label": "Put berries in",
  "actors": ["hero"],
  "target": { "tags": ["store"] },
  "range": 2,
  "duration": 2,
  "order": 10,
  "requires": [
    { "if": "target.state == empty", "else": "The store is full" },
    { "if": "has(berries, 2)", "else": "You need 2 berries" }
  ],
  "effects": [
    "take actor berries 2",
    "set target.state stocked"
  ]
}
