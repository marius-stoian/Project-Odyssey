// Needs a hammerstone; the nodule is spent for two minutes.
{
  "id": "chip-flint",
  "label": "Chip the nodule",
  "actors": ["hero"],
  "target": { "tags": ["flint-nodule"] },
  "range": 2,
  "duration": 4,
  "order": 10,
  "requires": [
    { "if": "target.state == full", "else": "Nothing left to chip" },
    { "if": "has(hammerstone, 1)", "else": "Needs a hammerstone" }
  ],
  "effects": [
    "give actor flint 2",
    "set target.state chipped",
    "after 2m set target.state full"
  ]
}
