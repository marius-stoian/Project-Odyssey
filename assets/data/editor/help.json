// What every Editor field says about itself (US-300, D-58). One entry per field id "<panel>.<label>"; the id is the field's label in lower case.
// purpose, range and example show in the tooltip after the pointer rests on the field (0.4 s). A number field's range is made from its own minimum
// and maximum when the entry has no range. suggest: number, none, values:a|b|c, files:<folder>/<glob> or catalog:<name>; list: true completes the item
// after the last comma. Edit this file in a text editor; the Editor and a test check that every field has an entry.
{ "version": 1,
  "fields": {
    "building.level": {"purpose":"The level this building's door leads into, when its interior is a map; empty follows the kind","range":"a level file without .json","example":"hut-inside","suggest":"catalog:levels"},
    "building.owner": {"purpose":"The person who owns this building (-1 means nobody)","example":"7","suggest":"number"},
    "class.allow": {"purpose":"Interactions NPCs of this class may do; a deny always wins","range":"interaction ids, separated by commas","example":"talk, barter","suggest":"catalog:interactions","list":true},
    "class.colour": {"purpose":"The ring colour round the marker of NPCs of this class","range":"# and six hex digits","example":"#3a9a4c","suggest":"none"},
    "class.day": {"purpose":"What NPCs of this class do by day: blocks of time, activity and place","range":"hh:mm activity place; blocks separated by semicolons; the place is optional (home)","example":"06:00 work market; 21:00 sleep home","suggest":"none"},
    "class.deny": {"purpose":"Interactions NPCs of this class may never do","range":"interaction ids, separated by commas","example":"barter","suggest":"catalog:interactions","list":true},
    "class.does": {"purpose":"Interactions NPCs of this class choose to do on their own when free","range":"interaction ids, separated by spaces","example":"patrol sing","suggest":"catalog:interactions","list":true},
    "class.id": {"purpose":"The class id; it is also the file name","range":"letters, digits and hyphens, up to 32","example":"healer","suggest":"none"},
    "class.label": {"purpose":"The name menus show for this class","range":"up to 24 letters","example":"Healer","suggest":"none"},
    "class.night": {"purpose":"What NPCs of this class do at night, when it differs from the day; empty means the day blocks hold","range":"hh:mm activity place; blocks separated by semicolons","example":"21:00 sleep home","suggest":"none"},
    "class.picks-day": {"purpose":"Weighted random deliveries to NPCs of this class a day; each adds one piece","range":"0 to 20, or empty","example":"2","suggest":"none"},
    "class.rare": {"purpose":"Goods kept back for people NPCs of this class like, each with the lowest attitude that unlocks it","range":"item=word: hostile, wary, suspicious, neutral, friendly, enchanted, lovingly","example":"obsidian=friendly","suggest":"none"},
    "class.restock-day": {"purpose":"Pieces delivered to NPCs of this class every day","range":"item=number, 0 to 999","example":"flint=1","suggest":"catalog:items"},
    "class.stock": {"purpose":"The goods NPCs of this class have in stock at the start; also the target the price curve measures against","range":"item=number, 0 to 9999","example":"flint=6 fur=2","suggest":"catalog:items"},
    "class.sub-does": {"purpose":"Default actions of NPCs of this class for the partner type shown in the row above","range":"interaction ids, separated by spaces","example":"greet wave","suggest":"catalog:interactions","list":true},
    "class.tags": {"purpose":"Tags carried by NPCs of this class; interaction files aim at tags","range":"words separated by commas, up to 60 letters","example":"trader, elder","suggest":"catalog:tags","list":true},
    "class.talk": {"purpose":"The dialogue file used with each partner type, for NPCs of this class","range":"partner=file.dlg, separated by commas","example":"player=greet.dlg, animal=growl.dlg","suggest":"none"},
    "class.wants": {"purpose":"Goods NPCs of this class buy at full value; any other good is bought at half","range":"item ids, separated by spaces or commas","example":"berries fur","suggest":"catalog:items","list":true},
    "class.weights": {"purpose":"How likely each good is in the random deliveries to NPCs of this class","range":"item=number, 0 to 1000; 0 switches an inherited weight off","example":"fur=3","suggest":"catalog:items"},
    "economy.goods": {"purpose":"Goods the region delivers to its traders, each with a weight","range":"item=number","example":"berries=5 flint=3","suggest":"catalog:items"},
    "economy.money": {"purpose":"Items that are money in this region, each with its value","range":"item=number, a number of 1 or more","example":"shells=1 gold=10","suggest":"catalog:items"},
    "economy.places": {"purpose":"Named spots of the map that schedules can send people to","range":"name=x,y/tag/tag in tiles; name is not home","example":"market=20,10 grove=30,12/forage/shelter","suggest":"none"},
    "economy.prices": {"purpose":"The base price of goods in this region","range":"item=number","example":"flint=4","suggest":"catalog:items"},
    "event.id": {"purpose":"The id of a new story event; it becomes the file name","range":"letters, digits and hyphens","example":"lost-flint","suggest":"none"},
    "event.max-age": {"purpose":"The oldest age at which the hero can meet this event","example":"25","suggest":"number"},
    "event.min-age": {"purpose":"The youngest age at which the hero can meet this event","example":"12","suggest":"number"},
    "event.needs-affinity": {"purpose":"An affinity the hero needs before this event is drawn; empty means none","range":"an affinity key","example":"hunter","suggest":"values:hunter|gatherer|knapper|fireKeeper|shaman|trade|religion"},
    "event.needs-at-least": {"purpose":"The lowest value of that affinity","example":"12","suggest":"number"},
    "event.order": {"purpose":"Where the event stands in the list; the yearly draw depends on it","example":"1","suggest":"number"},
    "event.sub-affinities": {"purpose":"How this option moves the hero's affinities","range":"name=number, separated by spaces","example":"knapper=7 trade=2","suggest":"none"},
    "event.sub-chronicle": {"purpose":"The line the chronicle keeps about this option; {hero} and {other} are filled in","range":"up to 200 letters","example":"{hero} found a good piece of flint.","suggest":"none"},
    "event.sub-opinion": {"purpose":"How this option changes the opinion of the person the event involves","example":"5","suggest":"number"},
    "event.sub-says": {"purpose":"The words of this option","range":"up to 200 letters","example":"Keep it and learn to work it.","suggest":"none"},
    "event.sub-trait": {"purpose":"A trait the hero gets by choosing this option; empty means none","range":"one trait word","example":"brave","suggest":"none"},
    "event.text": {"purpose":"What the player reads before choosing","range":"up to 400 letters","example":"You find a fine piece of flint in the riverbed.","suggest":"none"},
    "event.title": {"purpose":"The event's headline","range":"up to 80 letters","example":"The lost flint","suggest":"none"},
    "event.trigger": {"purpose":"A condition in the rule language that must hold for the event to be drawn; empty means always","range":"rule language, up to 200 letters","example":"flag(met-elder)","suggest":"none"},
    "event.who": {"purpose":"Who the event involves","range":"elder or friend","example":"friend","suggest":"values:elder|friend"},
    "graph.actor.actors": {"purpose":"Who may do this: hero, person, animal or the name of a kind","range":"words separated by spaces","example":"hero person","suggest":"values:hero|person|animal","list":true},
    "graph.bar.name": {"purpose":"The name of a new file; New starts it and Save writes it","range":"letters, digits and hyphens","example":"elder-fire","suggest":"none"},
    "graph.branch.if": {"purpose":"A condition; the first branch that holds is taken instead of the step's next","range":"rule language","example":"flag(fire-out)","suggest":"none"},
    "graph.choice.else": {"purpose":"The reason shown when the choice's condition is false; empty hides the choice instead","range":"words","example":"You have no berries","suggest":"none"},
    "graph.choice.text": {"purpose":"What the player may choose to say","range":"words","example":"Offer berries","suggest":"none"},
    "graph.chronicle.text": {"purpose":"A line for the clan's chronicle; {actor.name} and such are filled in","range":"words","example":"{actor.name} shared berries","suggest":"none"},
    "graph.comment.note": {"purpose":"A note for you; it stays attached to what it is wired to","range":"words","example":"Check this with the elder.","suggest":"none"},
    "graph.condition.if": {"purpose":"A condition in the rule language; wire it to the if port of a line or a choice","range":"rule language","example":"has(hero, berries, 1)","suggest":"none"},
    "graph.effect.do": {"purpose":"An effect that runs when the choice is taken; one per line","range":"effect words","example":"take hero berries 1","suggest":"none"},
    "graph.effects.do": {"purpose":"What happens when the action finishes, one effect per line, in order","range":"effect words","example":"give actor berries 2","suggest":"none"},
    "graph.fail.if": {"purpose":"When any one of these holds the quest fails for good","range":"rule language","example":"hero.dead","suggest":"none"},
    "graph.goto.to": {"purpose":"The id of the node to jump to","range":"a node id","example":"start","suggest":"none"},
    "graph.header.bark": {"purpose":"Makes this a one-line greeting of that kind, spoken as a speech bubble; empty means a conversation","range":"one word","example":"greet","suggest":"none"},
    "graph.header.pair": {"purpose":"Makes this a talk between two clan members: who starts, then who answers","range":"two words: a name, a role or a kind each","example":"elder child","suggest":"none"},
    "graph.header.priority": {"purpose":"When several conversations fit, the highest wins","range":"-1000 to 1000, default 0","example":"10","suggest":"number"},
    "graph.header.when": {"purpose":"The conversation may be used only while this is true; empty means always","range":"rule language","example":"opinion(npc, hero) >= -20","suggest":"none"},
    "graph.header.who": {"purpose":"Who the conversation is for: a name, a role or a kind; more than one word is allowed","range":"words separated by spaces","example":"elder","suggest":"none"},
    "graph.line.says": {"purpose":"What is said; {hero}, {npc} and {season} are filled in","range":"words","example":"The fire is low tonight, {hero}.","suggest":"none"},
    "graph.line.who": {"purpose":"The speaker of this line","range":"a name or a speaker word","example":"Elder","suggest":"none"},
    "graph.node.id": {"purpose":"The id of this node; a choice leads here by this id","range":"one word","example":"start","suggest":"none"},
    "graph.npcrule.cooldown": {"purpose":"Seconds before an NPC does this again","range":"whole seconds","example":"60","suggest":"none"},
    "graph.npcrule.score": {"purpose":"How much clan members and animals want to do this; higher wins","range":"rule language","example":"need(hunger) * 2 + trait(diligent) * 10","suggest":"none"},
    "graph.quest.giver": {"purpose":"Who gives the quest: a person id, role:<role>, or none to start by itself","range":"person id, role:<role> or none","example":"role:elder","suggest":"none"},
    "graph.quest.id": {"purpose":"The quest's id; it must be the file name without .json","range":"letters, digits, - or _","example":"first-day","suggest":"none"},
    "graph.quest.journal": {"purpose":"The line the journal shows once the quest is done","range":"words","example":"The elder taught me the first things a clan needs.","suggest":"none"},
    "graph.quest.note": {"purpose":"Your own words; they are kept when the Editor saves","range":"words","example":"Teaches the first things a clan needs.","suggest":"none"},
    "graph.quest.offer": {"purpose":"What the giver says when offering the quest; empty means the title and the first step","range":"words","example":"The clan is hungry. Will you help?","suggest":"none"},
    "graph.quest.title": {"purpose":"The name the journal and tracker show","range":"words","example":"The First Day","suggest":"none"},
    "graph.quest.turn-in": {"purpose":"What the giver says when the quest is handed in","range":"words","example":"Well done. The clan eats tonight.","suggest":"none"},
    "graph.requirement.else": {"purpose":"Why the action is greyed out when the condition is false","range":"words","example":"Nothing grows in winter","suggest":"none"},
    "graph.requirement.if": {"purpose":"A condition that must hold; the first false one greys the action out","range":"rule language","example":"season != winter","suggest":"none"},
    "graph.requires.if": {"purpose":"A prerequisite: all must hold before the quest is available","range":"rule language","example":"quest(first-day) == done","suggest":"none"},
    "graph.rewards.do": {"purpose":"An effect run when the quest ends, aimed at the hero; one per line","range":"effect words","example":"give hero flint 2","suggest":"none"},
    "graph.step.goal": {"purpose":"What the player must do to finish the step","range":"talk, goto, gather, give, craft, interact, defeat, wait or flag, then its words","example":"gather berries 3","suggest":"none"},
    "graph.step.hint-in": {"purpose":"How long without progress before the hint shows","range":"a number with s or m","example":"2m","suggest":"none"},
    "graph.step.hint": {"purpose":"The hint shown when the goal has not moved for that long","range":"words","example":"Berry bushes grow by the stream.","suggest":"none"},
    "graph.step.id": {"purpose":"The id of this step; wires and branches name it","range":"one word","example":"eat","suggest":"none"},
    "graph.step.marker": {"purpose":"Where the map marker points","range":"tag:<tag>, object:<id>, npc:<id> or place:<name>","example":"tag:edible","suggest":"catalog:markers"},
    "graph.step.text": {"purpose":"What the tracker and journal show for this step","range":"words","example":"Gather berries for the clan.","suggest":"none"},
    "graph.target.kinds": {"purpose":"Kinds the target may be; with tags too, either match counts","range":"words separated by spaces","example":"deer","suggest":"catalog:characters","list":true},
    "graph.target.tags": {"purpose":"What the action can be done to: the thing must carry every tag","range":"words separated by spaces","example":"edible plant","suggest":"catalog:tags","list":true},
    "graph.test.state": {"purpose":"The values Test-play starts with, typed as words","range":"words separated by spaces","example":"opinion=25 item.berries=2 time=night","suggest":"none"},
    "graph.verb.id": {"purpose":"The interaction's id; it must be the file name without .json","range":"letters, digits, - or _","example":"gather","suggest":"none"},
    "graph.verb.label": {"purpose":"What the menu shows; {target.name}, {actor.name} and {npc.name} are filled in","range":"words","example":"Gather {target.name}","suggest":"none"},
    "graph.verb.menu": {"purpose":"Put the action in another menu; empty is the ordinary right-click menu","range":"confront or empty","example":"confront","suggest":"values:confront"},
    "graph.verb.note": {"purpose":"Your own words; they are kept when the Editor saves","range":"words","example":"Anything you write here survives the Editor.","suggest":"none"},
    "graph.verb.order": {"purpose":"The position in the menu; lower comes first","range":"0 to 1000, default 100","example":"100","suggest":"none"},
    "graph.verb.range-m": {"purpose":"How close the actor must be, in metres","range":"0 to 30, default 1.5","example":"1.5","suggest":"none"},
    "graph.verb.secs": {"purpose":"Seconds the action takes; 0 means instant","range":"0 to 600","example":"3","suggest":"none"},
    "kind.allow": {"purpose":"Interactions characters of this kind may do; a deny always wins","range":"interaction ids, separated by commas","example":"talk, barter","suggest":"catalog:interactions","list":true},
    "kind.day": {"purpose":"What characters of this kind do by day: blocks of time, activity and place","range":"hh:mm activity place; blocks separated by semicolons; the place is optional (home)","example":"06:00 work market; 21:00 sleep home","suggest":"none"},
    "kind.deny": {"purpose":"Interactions characters of this kind may never do","range":"interaction ids, separated by commas","example":"barter","suggest":"catalog:interactions","list":true},
    "kind.does": {"purpose":"Interactions characters of this kind choose to do on their own when free","range":"interaction ids, separated by spaces","example":"patrol sing","suggest":"catalog:interactions","list":true},
    "kind.night": {"purpose":"What characters of this kind do at night, when it differs from the day; empty means the day blocks hold","range":"hh:mm activity place; blocks separated by semicolons","example":"21:00 sleep home","suggest":"none"},
    "kind.picks-day": {"purpose":"Weighted random deliveries to characters of this kind a day; each adds one piece","range":"0 to 20, or empty","example":"2","suggest":"none"},
    "kind.rare": {"purpose":"Goods kept back for people characters of this kind like, each with the lowest attitude that unlocks it","range":"item=word: hostile, wary, suspicious, neutral, friendly, enchanted, lovingly","example":"obsidian=friendly","suggest":"none"},
    "kind.restock-day": {"purpose":"Pieces delivered to characters of this kind every day","range":"item=number, 0 to 999","example":"flint=1","suggest":"catalog:items"},
    "kind.stock": {"purpose":"The goods characters of this kind have in stock at the start; also the target the price curve measures against","range":"item=number, 0 to 9999","example":"flint=6 fur=2","suggest":"catalog:items"},
    "kind.sub-does": {"purpose":"Default actions of characters of this kind for the partner type shown in the row above","range":"interaction ids, separated by spaces","example":"greet wave","suggest":"catalog:interactions","list":true},
    "kind.tags": {"purpose":"Tags carried by characters of this kind; interaction files aim at tags","range":"words separated by commas, up to 60 letters","example":"trader, elder","suggest":"catalog:tags","list":true},
    "kind.talk": {"purpose":"The dialogue file used with each partner type, for characters of this kind","range":"partner=file.dlg, separated by commas","example":"player=greet.dlg, animal=growl.dlg","suggest":"none"},
    "kind.wants": {"purpose":"Goods characters of this kind buy at full value; any other good is bought at half","range":"item ids, separated by spaces or commas","example":"berries fur","suggest":"catalog:items","list":true},
    "kind.weights": {"purpose":"How likely each good is in the random deliveries to characters of this kind","range":"item=number, 0 to 1000; 0 switches an inherited weight off","example":"fur=3","suggest":"catalog:items"},
    "level.height": {"purpose":"Height of the level in cells; growing adds ground at the bottom, shrinking cuts from there","example":"64","suggest":"number"},
    "level.name": {"purpose":"The level's name; the log shows it and it seeds the weather","range":"up to 20 letters","example":"The Valley","suggest":"none"},
    "level.width": {"purpose":"Width of the level in cells; growing adds ground on the right, shrinking cuts from there","example":"64","suggest":"number"},
    "npc-life.day": {"purpose":"What this NPC do by day: blocks of time, activity and place","range":"hh:mm activity place; blocks separated by semicolons; the place is optional (home)","example":"06:00 work market; 21:00 sleep home","suggest":"none"},
    "npc-life.does": {"purpose":"Interactions this NPC choose to do on their own when free","range":"interaction ids, separated by spaces","example":"patrol sing","suggest":"catalog:interactions","list":true},
    "npc-life.night": {"purpose":"What this NPC do at night, when it differs from the day; empty means the day blocks hold","range":"hh:mm activity place; blocks separated by semicolons","example":"21:00 sleep home","suggest":"none"},
    "npc-life.picks-day": {"purpose":"Weighted random deliveries to this NPC a day; each adds one piece","range":"0 to 20, or empty","example":"2","suggest":"none"},
    "npc-life.rare": {"purpose":"Goods kept back for people this NPC like, each with the lowest attitude that unlocks it","range":"item=word: hostile, wary, suspicious, neutral, friendly, enchanted, lovingly","example":"obsidian=friendly","suggest":"none"},
    "npc-life.restock-day": {"purpose":"Pieces delivered to this NPC every day","range":"item=number, 0 to 999","example":"flint=1","suggest":"catalog:items"},
    "npc-life.stock": {"purpose":"The goods this NPC have in stock at the start; also the target the price curve measures against","range":"item=number, 0 to 9999","example":"flint=6 fur=2","suggest":"catalog:items"},
    "npc-life.sub-does": {"purpose":"Default actions of this NPC for the partner type shown in the row above","range":"interaction ids, separated by spaces","example":"greet wave","suggest":"catalog:interactions","list":true},
    "npc-life.wants": {"purpose":"Goods this NPC buy at full value; any other good is bought at half","range":"item ids, separated by spaces or commas","example":"berries fur","suggest":"catalog:items","list":true},
    "npc-life.weights": {"purpose":"How likely each good is in the random deliveries to this NPC","range":"item=number, 0 to 1000; 0 switches an inherited weight off","example":"fur=3","suggest":"catalog:items"},
    "npc.family": {"purpose":"The family of this person; people of one family are kin (0 means none)","example":"3","suggest":"number"},
    "npc.hp": {"purpose":"Health of this placed character","example":"60","suggest":"number"},
    "npc.name": {"purpose":"The name of this placed character","range":"up to 18 letters","example":"Ossa","suggest":"none"},
    "npc.script": {"purpose":"The .dlg file this person uses with the partner type chosen above","range":"a file of assets/data/dialogue","example":"elder-fire.dlg","suggest":"files:dialogue/*.dlg"},
    "npc.sword": {"purpose":"Damage of one sword strike by this character","example":"4","suggest":"number"},
    "plant.own": {"purpose":"Own values of an interaction for this plant only; the kind's values stay for the others","range":"interaction.field=number: delay or duration, in seconds","example":"gather.delay=60","suggest":"catalog:interaction-fields"},
    "prefab.cost": {"purpose":"The materials needed; empty means the sum of the pieces","range":"item=number","example":"wood=10 fur=2","suggest":"catalog:items"},
    "prefab.h": {"purpose":"Height of the footprint in cells","example":"3","suggest":"number"},
    "prefab.id": {"purpose":"The prefab's id; it becomes the file name","range":"letters, digits and hyphens, not an id of kinds.json","example":"test-lodge","suggest":"none"},
    "prefab.level": {"purpose":"The level the door leads into when the interior is a map","range":"a level file without .json","example":"hut-inside","suggest":"catalog:levels"},
    "prefab.name": {"purpose":"The name the Build menu shows","range":"up to 30 letters","example":"Test lodge","suggest":"none"},
    "prefab.seconds": {"purpose":"Seconds of work to build it; 0 means the sum of the pieces","example":"40","suggest":"number"},
    "prefab.w": {"purpose":"Width of the footprint in cells","example":"4","suggest":"number"}
  } }
